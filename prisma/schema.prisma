generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Singleton-style platform settings (one row: id = "default")
model PlatformSettings {
  id                     String   @id @default("default")
  platformName           String
  supportEmail           String
  supportPhone           String
  allowSelfRegistration  Boolean  @default(true)
  requireApproval        Boolean  @default(true)
  defaultTrialDays       Int      @default(14)
  defaultPlanId          String
  currency               String   @default("PKR")
  whatsappEnabled        Boolean  @default(true)
  smsEnabled             Boolean  @default(true)
  jazzcashEnabled        Boolean  @default(true)
  easypaisaEnabled       Boolean  @default(true)
  stripeEnabled          Boolean  @default(true)
  maintenanceMode        Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model PlatformPlan {
  id           String   @id
  name         String
  code         String   @unique
  priceMonthly Int
  priceYearly  Int
  currency     String   @default("PKR")
  maxStudents  Int
  maxStaff     Int
  maxCampuses  Int
  modules      String[]
  trialDays    Int      @default(14)
  published    Boolean  @default(true)
  description  String
  highlight    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schools        SchoolTenant[]
  registrations  SchoolRegistration[]
}

model SchoolTenant {
  id                   String   @id
  code                 String
  name                 String
  shortName            String
  type                 String
  city                 String
  address              String
  phone                String
  email                String
  countryCode          String   @default("PK")
  status               String
  planId               String
  billingCycle         String
  modulesOverride      String[] @default([])
  maxStudentsOverride  Int?
  maxStaffOverride     Int?
  studentsCount        Int      @default(0)
  staffCount           Int      @default(0)
  campusesCount        Int      @default(1)
  adminName            String
  adminEmail           String
  registeredAt         DateTime @db.Date
  trialEndsAt          DateTime? @db.Date
  subscriptionEndsAt   DateTime? @db.Date
  mrr                  Int      @default(0)
  notes                String?
  logoInitials         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  plan      PlatformPlan    @relation(fields: [planId], references: [id])
  invoices  PlatformInvoice[]
  workspace SchoolWorkspace?

  @@index([status])
  @@index([planId])
}

model SchoolRegistration {
  id               String    @id
  instituteName    String
  instituteType    String
  city             String
  address          String
  phone            String
  email            String
  adminName        String
  adminEmail       String
  adminPhone       String
  requestedPlanId  String
  expectedStudents Int
  message          String?
  status           String
  submittedAt      DateTime
  reviewedAt       DateTime?
  reviewNote       String?

  plan PlatformPlan @relation(fields: [requestedPlanId], references: [id])

  @@index([status])
}

model PlatformUser {
  id           String   @id
  name         String
  email        String   @unique
  role         String
  active       Boolean  @default(true)
  lastActiveAt DateTime
  permissions  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PlatformInvoice {
  id         String    @id
  schoolId   String
  schoolName String
  planName   String
  amount     Int
  status     String
  period     String
  issuedAt   DateTime  @db.Date
  dueAt      DateTime  @db.Date
  paidAt     DateTime? @db.Date
  createdAt  DateTime  @default(now())

  school SchoolTenant @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([schoolId])
}

model PlatformAuditLog {
  id        String   @id
  at        DateTime
  actor     String
  action    String
  target    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([at])
}

/// Full school IMS operational payload (matches ImsData in the app)
model SchoolWorkspace {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant SchoolTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Portal login accounts (passwords stored bcrypt-hashed)
model AuthAccount {
  id                String   @id
  email             String   @unique
  password          String
  name              String
  role              String
  portal            String
  tenantId          String?
  linkedStudentId   String?
  linkedStudentIds  String[] @default([])
  linkedStaffId     String?
  description       String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}
