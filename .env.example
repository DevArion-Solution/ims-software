# Environment
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# PostgreSQL connection (do not commit real production secrets)
DATABASE_URL="postgresql://postgres:1234@localhost:5432/ims?schema=public"

# Session signing secret (min 16 chars — change in production)
SESSION_SECRET="ims-dev-session-secret-change-me-in-production"

# Public app URL (payment return / webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Integrations — default sandbox when keys missing or INTEGRATIONS_SANDBOX=true
INTEGRATIONS_SANDBOX="true"
PAYMENTS_SANDBOX="true"

# JazzCash (live)
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=
# JAZZCASH_RETURN_URL=http://localhost:3000/api/payments/webhook/jazzcash

# Easypaisa (live)
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=
# EASYPAISA_RETURN_URL=http://localhost:3000/api/payments/webhook/easypaisa

# Stripe (Parent fee pay — sandbox without keys; live Checkout when configured)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=pkr
# STRIPE_DISABLED=0

# SMS — Twilio or local PK gateway
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Email / Gmail SMTP (absence + fee alerts)
# Gmail: enable 2FA → App Password → use smtp.gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourschool@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="School Name <yourschool@gmail.com>"
# EMAIL_WEBHOOK_URL=   # optional alternative to SMTP

# WhatsApp Cloud API (Meta)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# Biometric / ZKTeco device shared key
# POST /api/attendance/device with headers: x-device-key, x-tenant-id
# ATTENDANCE_DEVICE_KEY=change-me-device-secret

# Also set INTEGRATIONS_SANDBOX=false for live WhatsApp/SMS/email
